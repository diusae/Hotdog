<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:models="clr-namespace:Skua.Core.Models;assembly=Skua.Core.Models"
             x:Name="Root"
             x:Class="Skua.Shared.Avalonia.Controls.Shell.WindowTitleBar">
  <Grid Height="40"
        Background="{DynamicResource SkuaSurfaceBrush}">
    <Image x:Name="ArtworkImage" Grid.ColumnSpan="3" Stretch="UniformToFill" Opacity="0.16" IsHitTestVisible="False" />
    <Border Grid.ColumnSpan="3"
            Background="{DynamicResource SkuaTitleBarOverlayBrush}"
            IsHitTestVisible="False" />
    <Border Grid.ColumnSpan="3"
            Height="1"
            VerticalAlignment="Bottom"
            Background="{DynamicResource SkuaBorderBrush}"
            IsHitTestVisible="False" />
    <Border Width="3"
            HorizontalAlignment="Left"
            Background="{DynamicResource SkuaAccentBrush}"
            IsHitTestVisible="False" />
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="48" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0"
          Width="32"
          Height="32"
          Margin="9,0,5,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
      <Border Width="32"
              Height="32"
              Classes="titlebar-app-badge"
              CornerRadius="9" />
      <TextBlock Text="{x:Static models:ProductIdentity.ProductMonogram}"
                 Foreground="{DynamicResource SkuaAccentForegroundBrush}"
                 FontSize="11"
                 FontWeight="ExtraBold"
                 LetterSpacing="1"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Grid>

    <TextBlock x:Name="TitleTextBlock"
               Grid.Column="1"
               Margin="8,0,8,0"
               VerticalAlignment="Center"
               Text="{Binding TitleText, ElementName=Root}"
               TextTrimming="CharacterEllipsis"
               Classes="titlebar-title" />

    <StackPanel Grid.Column="2"
                Height="40"
                VerticalAlignment="Center"
                Orientation="Horizontal">
      <Button x:Name="MinimizeButton"
              Classes="titlebar"
              Content="{materialIcons:MaterialIconExt Kind=WindowMinimize, IconSize=13}" />
      <Button x:Name="MaximizeButton"
              Classes="titlebar"
              Content="{materialIcons:MaterialIconExt Kind=WindowMaximize, IconSize=13}" />
      <Button x:Name="CloseButton"
              Classes="titlebar titlebar-close"
              Content="{materialIcons:MaterialIconExt Kind=WindowClose, IconSize=13}" />
    </StackPanel>
  </Grid>
</UserControl>
