<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- HOT DOG design tokens. Keep all control colours here so Client and Manager stay visually consistent. -->
    <Color x:Key="SkuaAccentColor">#F97316</Color>
    <Color x:Key="SkuaAccentForegroundColor">#FF111827</Color>
    <SolidColorBrush x:Key="SkuaAccentBrush" Color="{StaticResource SkuaAccentColor}" />
    <SolidColorBrush x:Key="SkuaAccentForegroundBrush" Color="{StaticResource SkuaAccentForegroundColor}" />
    <SolidColorBrush x:Key="SkuaAccentHoverBrush" Color="#EA580C" />
    <SolidColorBrush x:Key="SkuaAccentPressedBrush" Color="#C2410C" />
    <SolidColorBrush x:Key="SkuaAccentGlowBrush" Color="#35F97316" />

    <SolidColorBrush x:Key="SkuaDangerBrush" Color="#F05252" />
    <SolidColorBrush x:Key="SkuaDangerHoverBrush" Color="#DC3636" />
    <SolidColorBrush x:Key="SkuaDangerPressedBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="SkuaDangerForegroundBrush" Color="#FFFFFFFF" />

    <!-- Fluent controls are synchronised with the active accent at runtime. -->
    <Color x:Key="SystemAccentColor">#F97316</Color>
    <Color x:Key="SystemAccentColorLight1">#FB923C</Color>
    <Color x:Key="SystemAccentColorLight2">#FDBA74</Color>
    <Color x:Key="SystemAccentColorLight3">#FED7AA</Color>
    <Color x:Key="SystemAccentColorDark1">#EA580C</Color>
    <Color x:Key="SystemAccentColorDark2">#C2410C</Color>
    <Color x:Key="SystemAccentColorDark3">#9A3412</Color>

    <SolidColorBrush x:Key="SkuaTagBackgroundBrush" Color="#22F97316" />
    <SolidColorBrush x:Key="SkuaTagBackgroundHoverBrush" Color="#3BF97316" />
    <SolidColorBrush x:Key="SkuaTagBorderBrush" Color="#4DF97316" />
    <SolidColorBrush x:Key="SkuaTagBorderHoverBrush" Color="#80F97316" />
    <SolidColorBrush x:Key="SkuaTagTextBrush" Color="#FDBA74" />
    <SolidColorBrush x:Key="SkuaAccentTintBrush" Color="#24F97316" />
    <SolidColorBrush x:Key="SkuaAccentTintStrongBrush" Color="#38F97316" />

    <SolidColorBrush x:Key="SkuaDangerTintBrush" Color="#1FF05252" />
    <SolidColorBrush x:Key="SkuaDangerTintStrongBrush" Color="#33F05252" />
    <SolidColorBrush x:Key="SkuaDangerSoftBorderBrush" Color="#73F05252" />
    <SolidColorBrush x:Key="SkuaSuccessTintBrush" Color="#1F22C55E" />
    <SolidColorBrush x:Key="SkuaSuccessTintBorderBrush" Color="#5922C55E" />
    <SolidColorBrush x:Key="SkuaWarningTintBrush" Color="#1FFBBF24" />
    <SolidColorBrush x:Key="SkuaWarningTintBorderBrush" Color="#59FBBF24" />
    <SolidColorBrush x:Key="SkuaGoldTintBrush" Color="#1AFFD166" />
    <SolidColorBrush x:Key="SkuaGoldTintBorderBrush" Color="#52FFD166" />

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SkuaPageBrush" Color="#F3F6FA" />
            <SolidColorBrush x:Key="SkuaSidebarBrush" Color="#EAF0F6" />
            <SolidColorBrush x:Key="SkuaSurfaceBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SkuaSurfaceAltBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="SkuaSurfaceElevatedBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SkuaSurfaceSubtleBrush" Color="#EFF3F7" />
            <SolidColorBrush x:Key="SkuaTitleBarOverlayBrush" Color="#70F3F6FA" />
            <SolidColorBrush x:Key="SkuaBorderBrush" Color="#DCE4ED" />
            <SolidColorBrush x:Key="SkuaBorderStrongBrush" Color="#BCC9D8" />
            <SolidColorBrush x:Key="SkuaDividerBrush" Color="#E7ECF2" />
            <SolidColorBrush x:Key="SkuaNavHoverBrush" Color="#E9EFF6" />
            <SolidColorBrush x:Key="SkuaTextBrush" Color="#16202C" />
            <SolidColorBrush x:Key="SkuaMutedTextBrush" Color="#64748B" />
            <SolidColorBrush x:Key="SkuaSelectionBrush" Color="#33F97316" />
            <SolidColorBrush x:Key="SkuaHoverBrush" Color="#0C15202B" />
            <SolidColorBrush x:Key="SkuaHoverPressedBrush" Color="#18202C3A" />
            <SolidColorBrush x:Key="SkuaNavChipBrush" Color="#E7EDF4" />
            <SolidColorBrush x:Key="SkuaScrollThumbBrush" Color="#AAB8C8" />
            <SolidColorBrush x:Key="SkuaScrollThumbHoverBrush" Color="#8799AD" />
            <SolidColorBrush x:Key="SkuaScrollThumbPressedBrush" Color="#64788E" />
            <SolidColorBrush x:Key="SkuaSuccessBrush" Color="#15803D" />
            <SolidColorBrush x:Key="SkuaWarningBrush" Color="#B45309" />
            <SolidColorBrush x:Key="SkuaGoldBrush" Color="#A16207" />
            <SolidColorBrush x:Key="SkuaInfoBrush" Color="#0369A1" />
            <SolidColorBrush x:Key="SkuaPressedBrush" Color="#DFE7F0" />
            <SolidColorBrush x:Key="SkuaControlOffBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#94A3B8" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#64748B" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="#64748B" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="#94A3B8" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePointerOver" Color="#64748B" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFill" Color="Transparent" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#94A3B8" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#64748B" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#E2E8F0" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#E2E8F0" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#64748B" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#475569" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SkuaPageBrush" Color="#0A0F15" />
            <SolidColorBrush x:Key="SkuaSidebarBrush" Color="#0D141D" />
            <SolidColorBrush x:Key="SkuaSurfaceBrush" Color="#111923" />
            <SolidColorBrush x:Key="SkuaSurfaceAltBrush" Color="#172230" />
            <SolidColorBrush x:Key="SkuaSurfaceElevatedBrush" Color="#1C2938" />
            <SolidColorBrush x:Key="SkuaSurfaceSubtleBrush" Color="#202D3C" />
            <SolidColorBrush x:Key="SkuaTitleBarOverlayBrush" Color="#C00A0F15" />
            <SolidColorBrush x:Key="SkuaBorderBrush" Color="#29394A" />
            <SolidColorBrush x:Key="SkuaBorderStrongBrush" Color="#40566B" />
            <SolidColorBrush x:Key="SkuaDividerBrush" Color="#223142" />
            <SolidColorBrush x:Key="SkuaNavHoverBrush" Color="#1C2A39" />
            <SolidColorBrush x:Key="SkuaTextBrush" Color="#F1F5F9" />
            <SolidColorBrush x:Key="SkuaMutedTextBrush" Color="#9AAABD" />
            <SolidColorBrush x:Key="SkuaSelectionBrush" Color="#4AF97316" />
            <SolidColorBrush x:Key="SkuaHoverBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="SkuaHoverPressedBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="SkuaNavChipBrush" Color="#1D2B3A" />
            <SolidColorBrush x:Key="SkuaScrollThumbBrush" Color="#3A4C60" />
            <SolidColorBrush x:Key="SkuaScrollThumbHoverBrush" Color="#536A80" />
            <SolidColorBrush x:Key="SkuaScrollThumbPressedBrush" Color="#6B8298" />
            <SolidColorBrush x:Key="SkuaSuccessBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="SkuaWarningBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="SkuaGoldBrush" Color="#FCD34D" />
            <SolidColorBrush x:Key="SkuaInfoBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="SkuaPressedBrush" Color="#26384A" />
            <SolidColorBrush x:Key="SkuaControlOffBrush" Color="#64748B" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#64748B" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#A7B6C7" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="#A7B6C7" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="#64748B" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokePointerOver" Color="#A7B6C7" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFill" Color="Transparent" />
            <SolidColorBrush x:Key="RadioButtonOuterEllipseFillPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#64748B" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#A7B6C7" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#172230" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#172230" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#A7B6C7" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#F1F5F9" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
